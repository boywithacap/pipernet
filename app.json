{
  "expo": {
    "name": "PiperNet",
    "slug": "pipernet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/branding/wordmark-icon.png",
    "scheme": "pipernet",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android"],
    "ios": {
      "bundleIdentifier": "com.boywithacap.pipernet",
      "supportsTablet": true,
      "icon": {
        "light": "./assets/images/branding/wordmark-icon.png",
        "dark": "./assets/images/branding/wordmark-icon-dark.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.boywithacap.pipernet",
      "blockedPermissions": [
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/branding/wordmark-android.png",
        "monochromeImage": "./assets/images/branding/wordmark-android.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/branding/native-splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/images/branding/native-splash.png"
          }
        }
      ],
      "@react-native-vector-icons/lucide",
      "expo-font",
      "expo-video",
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Allow PiperNet to save photos and videos to your photo library.",
          "granularPermissions": [],
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow PiperNet to capture photos and videos.",
          "microphonePermission": "Allow PiperNet to record sound with your videos.",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": false
        }
      ],
      "react-native-compressor",
      "./plugins/with-bluetooth"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6d1dd0b4-9dc5-4c2f-bcee-1b937471fcac"
      }
    },
    "owner": "sreedhar_k.s",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/6d1dd0b4-9dc5-4c2f-bcee-1b937471fcac",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
